{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "local",
        "tag": "dns-direct"
      },
      {
        "type": "https",
        "tag": "dns-remote",
        "server": "1.1.1.1",
        "detour": "auto"
      }
    ],
    "rules": [
      {
        "domain": [
          "example.com"
        ],
        "action": "route",
        "server": "dns-direct"
      },
      {
        "domain": [
          "example.org"
        ],
        "action": "route",
        "server": "dns-direct"
      }
    ],
    "final": "dns-remote",
    "strategy": "prefer_ipv4"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "mtu": 9000,
      "auto_route": true,
      "strict_route": true,
      "stack": "system"
    }
  ],
  "outbounds": [
    {
      "type": "vless",
      "tag": "proxy-0",
      "server": "example.com",
      "server_port": 443,
      "uuid": "123e4567-e89b-12d3-a456-426614174000"
    },
    {
      "type": "vless",
      "tag": "proxy-1",
      "server": "example.org",
      "server_port": 443,
      "uuid": "123e4567-e89b-12d3-a456-426614174000"
    },
    {
      "type": "urltest",
      "tag": "auto",
      "outbounds": [
        "proxy-0",
        "proxy-1"
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "30s",
      "idle_timeout": "30m",
      "tolerance": 100,
      "interrupt_exist_connections": false
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": "dns-direct",
    "rules": [
      {
        "inbound": "tun-in",
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      }
    ],
    "final": "auto"
  }
}
